PORT=3000
BASE_URL=http://192.168.4.2:3000

EMAIL_USER=
EMAIL_PASS=

# MySQL database (Hostinger hPanel -> Databases, or local XAMPP/WAMP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=visitor_db

# Set to true on hosts that can't run a real Chrome browser (e.g. Hostinger
# Node.js Web App). Skips WhatsApp entirely; email notifications still work.
DISABLE_WHATSAPP=false
